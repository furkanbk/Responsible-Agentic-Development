# RADF — copy to .env and fill in. .env is git-ignored; never commit the key.

# Required: your OpenCode Zen API key (never hard-coded in source).
OPENCODE_API_KEY=sk-...

# Optional overrides. Defaults live in agentlib/core.py.
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Model ids. Defaults are gpt-5.4-nano / gpt-5.5 — set these only to override.
# Anything you pick here should also be priced in MODELS (agentlib/core.py), or
# estimate_cost() returns 0.0 for it. Note: gemini-* ids appear in Zen's /models
# listing but 400 on every call — see ARCHITECTURE.md decision #12.
# OPENCODE_CHEAP_MODEL=gpt-5.4-nano
# OPENCODE_STRONG_MODEL=gpt-5.5


# --- HW3: the channel (service.py) -------------------------------------------

# A FRESH bot from @BotFather. Never a personal account: the token IS the
# account, so anyone holding it is the bot. Required only for service.py.
TELEGRAM_BOT_TOKEN=

# Who the bot recognises: source:external_id=radf_user_id, comma separated.
# An id that is NOT listed here resolves to the anonymous identity — it reads
# team-visible records only and cannot write. The platform id is a lookup key,
# never a RADF user id (channel/identity.py).
# RADF_CHANNEL_USERS=telegram:123456789=berat,telegram:987654321=dias

# RADF user ids allowed to reach the privileged path. Necessary and NOT
# sufficient — T11.3 also requires an explicit in-channel confirmation.
# RADF_CHANNEL_ADMINS=berat

# Where the Telegram update offset is persisted (default: store/).
# Without it, a restart re-delivers everything Telegram still holds.
# RADF_TELEGRAM_OFFSET_PATH=store/telegram_offset.json

# Phase 10 (Alejandro): shared secret for GitHub webhook signature verification.
# Required for triggers/webhook.py; an unset secret rejects every delivery.
# GITHUB_WEBHOOK_SECRET=

# Where github-sourced replies (orphaned-decision notices) go. GitHub has no
# per-thread notion, so the team shares one key. Default: "team".
# GITHUB_THREAD_KEY=team

# Optional overrides for the orphan watcher (triggers/orphan_watch.py). Defaults:
# scan the repo root; remember the orphan set next to the graph under store/.
# RADF_SCAN_ROOT=
# RADF_ORPHAN_WATERMARK=store/orphan_watermark.json


# --- HW5: the retrieval layer ------------------------------------------------

# Required for `search_corpus` and the eval harness. Embeddings only — the agent
# loop still runs on Zen (OPENCODE_API_KEY above). Kept separate because they are
# separate accounts with separate spend.
OPENROUTER_API_KEY=sk-or-v1-...

# Embedding model. 1536-dim; a full re-index of this repo costs about $0.001, so
# there is no reason to skimp. Changing this INVALIDATES the whole index —
# vectors from two models are not comparable — so a change means a full reindex.
# RADF_EMBED_MODEL=openai/text-embedding-3-small

# Postgres + pgvector, from docker-compose.yml. `docker compose up -d` first.
# This is the ONLY store that is not a file: everything else stays where it was,
# and the sqlite overlay is explicitly NOT migrating here (decision #62).
# RADF_PG_DSN=postgresql://radf:radf@localhost:5433/radf

# Where embedding + rerank responses are cached, so re-running the eval harness
# is free and reproducible rather than a fresh bill. Default: store/cache/.
# RADF_RETRIEVAL_CACHE=store/cache
