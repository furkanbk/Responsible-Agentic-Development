# Secrets — never commit
.env

# Runtime data. The DERIVED graph is regenerated by scans (CLAUDE.md §6).
# The overlay and the run logs are authored/observed runtime state: real, but
# per-developer, so they are not shared through git either.
store/*.json
store/*.db
store/*.db-journal
store/runs/

# HW5 retrieval cache: embedding vectors + rerank verdicts, keyed by content
# hash. Purely DERIVED — a full rebuild is ~$0.002 and ~41s — and per-developer,
# so it is never shared through git. Note `store/*.db` above does not cover it:
# it lives one level down, in store/cache/.
store/cache/

# Notebook demo artifacts from the guidance scaffold
watchlist.json
watchlist_b.json
trash_b.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Notebook outputs (never commit — CLAUDE.md §2)
*.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Demo runtime: process logs and pids from app/run_demo.sh, and the memes
# themselves (binary, per-demo, not the repo's business).
app/logs/
!app/memes/.gitkeep
